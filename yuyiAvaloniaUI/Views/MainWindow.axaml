<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:vm="using:yuyiAvaloniaUI.ViewModels"
        xmlns:yuyiavaloniaui="using:yuyiAvaloniaUI"
        x:Class="yuyiAvaloniaUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        xmlns:menu="using:yuyiAvalonia.Base.ViewModels.Menu"
        xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        xmlns:mm ="using:yuyiAvalonia.Base.Helpers"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="CenterScreen"
        Width="1024"
        Height="640"
        MinWidth="768"
        MinHeight="512">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel x:Name="MainContainer">
        <Border x:Name="MainMenubar" 
                DockPanel.Dock="Top"
                Padding="1"
                Margin="0"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource BgToolbar}"
                BorderBrush="{DynamicResource BorderColor}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Menu Margin="0,0,0,0" ItemsSource="{Binding TopMenuItems}"></Menu>
            </StackPanel>
        </Border>
        

        <Border
                DockPanel.Dock="Bottom" 
                Padding="3" 
                Height="20" 
                Margin="0,0,0,0"
                Background="{DynamicResource BgToolbar}">
            <yuyiavaloniaui:Statusbar x:Name="MainStatusbar"></yuyiavaloniaui:Statusbar>
        </Border>

        <Border x:Name="StatusSeperator"
            DockPanel.Dock="Bottom"
                BorderThickness="0,0,0,1"
                Height="4"
                BorderBrush="{DynamicResource BorderColor}"
                Background="{DynamicResource BgToolbar}">
        </Border>

        <Border BorderBrush="{DynamicResource BorderColor}" CornerRadius="5">
            <TransitioningContentControl Content="{Binding CurrentPage}"/>
        </Border>
    </DockPanel>
</Window>