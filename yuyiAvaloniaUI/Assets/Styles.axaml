<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 指定预览时用一个「内边距为 10 像素的 Border」包裹当前编辑的控件 -->
  <Design.PreviewWith>
    <Border Padding="10">
    </Border>
  </Design.PreviewWith>

  <!--  文本块 - 全局默认文本颜色 -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--  滑块(Slider)样式                                                      -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <!-- 水平滑块样式 -->
  <Style Selector="Slider:horizontal">
    <!-- 轨道颜色 -->
    <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>

    <Style Selector="^ Track">
        <!-- 轨道按钮 -->
        <Style Selector="^ RepeatButton Border">
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Height" Value="6"/>
        </Style>

        <!-- Thumb 样式 -->
        <Style Selector="^ Thumb">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Background" Value="white"/>
            <Setter Property="BorderBrush" Value="white"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Thumb 悬停 -->
        <Style Selector="^ Thumb:pointerover">
            <Setter Property="Background" Value="white"/>
            <Setter Property="BorderBrush" Value="white"/>
        </Style>

        <!-- Thumb 按下 -->
        <Style Selector="^ Thumb:pressed">
            <Setter Property="Background" Value="white"/>
            <Setter Property="BorderBrush" Value="white"/>
        </Style>
    </Style>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--  菜单样式                                                             -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <Style Selector="MenuItem.top">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Padding" Value="10,6,10,6" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="Padding" Value="10,6,10,6" />
    <Setter Property="Margin" Value="2"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--  切换按钮样式                                                         -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <Style Selector="ToggleButton">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style Selector="ToggleButton:checked">
    <Setter Property="Background" Value="{DynamicResource AccentColorLight}"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--  侧边工具栏按钮                                                       -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <Style Selector="Button.SideToolbarButton">
    <Setter Property="Margin" Value="2,0,2,2" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />

    <Style Selector="^:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverColor}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ActiveColor}" />
    </Style>
  </Style>

  <Style Selector="Button.SideToolbarButton.Active">
    <Setter Property="Background" Value="{DynamicResource AccentColorLight}" />
  </Style>

  <Style Selector="Button.SideToolbarButton PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.SideToolbarButton TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--  搜索框样式                                                           -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <Style Selector="TextBox.Search">
    <Setter Property="Background" Value="{DynamicResource BgSearchInput}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,6" />

    <Style Selector="^:pointerover">
      <Style Selector="^ /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
      </Style>
    </Style>

    <Style Selector="^:focus">
      <Style Selector="^ /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
      </Style>
    </Style>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--  侧边栏分组标题                                                       -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <Style Selector="TextBlock.SidebarGroupName">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="4,8,4,4" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--  侧边栏菜单项按钮                                                     -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <Style Selector="Button.SidebarMenuItem">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,8" />

    <Style Selector="^:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgSidebarItemHover}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgSidebarItemPressed}" />
    </Style>
  </Style>

  <Style Selector="Button.SidebarMenuItem.Active">
    <Setter Property="Background" Value="{DynamicResource AccentColorLight}" />
  </Style>

  <Style Selector="Button.SidebarMenuItem PathIcon">
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.SidebarMenuItem TextBlock">
    <Setter Property="Padding" Value="0" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--  主内容区域按钮                                                        -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <Style Selector="Button.Primary">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource AccentColor}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontWeight" Value="Medium" />

    <Style Selector="^:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentColorHover}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentColorActive}" />
    </Style>
  </Style>

  <Style Selector="Button.Secondary">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource BtnDefault}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Padding" Value="16,8" />

    <Style Selector="^:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BtnDefaultHover}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BtnDefaultActive}" />
    </Style>
  </Style>

  <Style Selector="Button.Danger">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource ErrorColor}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontWeight" Value="Medium" />

    <Style Selector="^:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#DC2626" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#B91C1C" />
    </Style>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--  卡片样式                                                             -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{DynamicResource BgBody}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--  分割线样式                                                           -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <Style Selector="Border.Divider">
    <Setter Property="Background" Value="{DynamicResource DividerColor}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!--  徽章/标签样式                                                         -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->

  <Style Selector="Border.Badge">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <Style Selector="Border.BadgeSuccess">
    <Setter Property="Background" Value="{DynamicResource SuccessColorLight}" />
  </Style>

  <Style Selector="Border.BadgeWarning">
    <Setter Property="Background" Value="{DynamicResource WarningColorLight}" />
  </Style>

  <Style Selector="Border.BadgeError">
    <Setter Property="Background" Value="{DynamicResource ErrorColorLight}" />
  </Style>

  <Style Selector="Border.BadgeInfo">
    <Setter Property="Background" Value="{DynamicResource InfoColorLight}" />
  </Style>

</Styles>
