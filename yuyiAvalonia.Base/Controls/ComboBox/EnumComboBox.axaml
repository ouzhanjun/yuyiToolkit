<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:yuyiAvalonia.Base.Controls;assembly=yuyiAvalonia.Base"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="28"
             x:Class="yuyiAvalonia.Base.Controls.EnumComboBox"
             x:Name="This">
    
    <Border Background="{DynamicResource BgProperty}"
        CornerRadius="{DynamicResource CornerRadius}"
        Padding="-3"
        BorderBrush="{DynamicResource BorderColor}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        ClipToBounds="True"
        BorderThickness="{DynamicResource BorderThickness}">
        <ComboBox x:Name="PART_EnumComboBox"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderBrush="Transparent"
            FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
            SelectionChanged="OnSelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Border>
</UserControl>
