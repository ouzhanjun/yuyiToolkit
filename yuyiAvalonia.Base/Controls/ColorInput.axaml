<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:common="using:yuyiAvalonia.Base.Controls.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:yuyiAvalonia.Base.Controls"
             mc:Ignorable="d" d:DesignWidth="120" d:DesignHeight="60"
             x:Class="yuyiAvalonia.Base.Controls.ColorInput"
             x:Name="This">

<Panel>
    <Popup x:Name="PART_ColorPickerPopup"
        PlacementMode="AnchorAndGravity"
        PlacementAnchor="Left"
        PlacementGravity="Left"
        PlacementTarget="{Binding #Part_ColorPanel}"
        IsLightDismissEnabled="True"
        Width="250"
        IsOpen="{Binding IsPickerOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}">
        <Border Background="{DynamicResource BgContent}"
            BorderBrush="{DynamicResource BorderColor}"
            ClipToBounds="True"
            x:Name="DragHost"
            BorderThickness="1"
            CornerRadius="4"
            BoxShadow="0 4 16 0 #60000000">
            <controls:ColorPickerPanel x:Name="PART_ColorPicker"
                Color="{Binding PickerColor, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                Alpha="{Binding PickerAlpha, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
        </Border>
    </Popup>
        
    <common:PropertyBorder Background="{DynamicResource BgProperty}"
        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}"
        ClipToBounds="True"
        x:Name="PART_PropertyBorder"
        Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Grid x:Name="Part_ColorPanel" ColumnDefinitions="*" ColumnSpacing="1">
                 <Border Padding="-3">
                    <TextBox x:Name="PART_TextBox"
                        Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Left"
                        TextAlignment="Left"
                        Background="Transparent"
                        Padding="6,3,28,3"/>
                </Border>
                <Panel HorizontalAlignment="Right"
                    x:Name="PART_ColorPanel"
                    Margin="-2,-2,2,-2"
                    Width="18"
                    Height="18"
                    Cursor="Hand"
                    PointerPressed="ColorPreview_Click">
                    <Border x:Name="PART_ColorPreview"
                        BorderBrush="Transparent"
                        BorderThickness="1" 
                        ClipToBounds="True"
                        CornerRadius="3"
                        Width="18"
                        Height="18">
                    </Border>
                    <Border 
                        CornerRadius="3"
                        Cursor="Hand"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" 
                        Width="18"
                        Height="18"
                        Background="Transparent"
                        ClipToBounds="True">
                    </Border>
                </Panel>
            </Grid>
        </common:PropertyBorder>
    </Panel>
</UserControl>
