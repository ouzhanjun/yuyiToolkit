<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:common="using:yuyiAvalonia.Base.Controls.Common"
             xmlns:controls="clr-namespace:yuyiAvalonia.Base.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="170"
             d:DesignHeight="30"
             x:Class="yuyiAvalonia.Base.Controls.IconTextDropDown"
             x:Name="This">

    <UserControl.Styles>
        <Style Selector="Button.DropDownTrigger">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.DropDownTrigger:pointerover">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.DropDownTrigger:pressed">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource BgToolbar}"/>
        </Style>
        <Style Selector="Border.DropDownItemSurface">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.DropDownItemSurface:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgToolbar}"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <common:PropertyBorder x:Name="PART_PropertyBorder"
                               Background="{DynamicResource BgProperty}"
                               CornerRadius="{Binding #This.CornerRadius}"
                               ClipToBounds="True">
            <Button x:Name="PART_Trigger"
                    Classes="DropDownTrigger"
                    Click="Trigger_Click"
                    KeyDown="Trigger_KeyDown"
                    ToolTip.Tip="{Binding #This.ToolTipText}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Border Width="20"
                            Height="20"
                            CornerRadius="3"
                            Background="{DynamicResource BgToolbar}"
                            VerticalAlignment="Center"
                            IsVisible="{Binding #This.SelectedItem.HasIcon}">
                        <PathIcon Data="{Binding #This.SelectedItem.Icon}"
                                  Width="13"
                                  Height="13"
                                  Foreground="{DynamicResource TextSecondary}"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding #This.SelectedItem.Text}"
                               FontSize="10"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2"
                               Text="▾"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               Opacity="0.75"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </common:PropertyBorder>

        <Popup x:Name="PART_Popup"
               PlacementTarget="{Binding #PART_Trigger}"
               PlacementMode="AnchorAndGravity"
               PlacementAnchor="BottomLeft"
               PlacementGravity="BottomRight"
               HorizontalOffset="0"
               VerticalOffset="5"
               IsLightDismissEnabled="True"
               IsOpen="{Binding #This.IsOpen, Mode=TwoWay}">
            <Border Background="{DynamicResource BgContent}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="4"
                    BoxShadow="0 4 12 0 #40000000"
                    Padding="4"
                    MinWidth="170">
                <ListBox x:Name="PART_ItemsListBox"
                         ItemsSource="{Binding #This.ItemsSource}"
                         SelectedItem="{Binding #This.SelectedItem, Mode=TwoWay}"
                         SelectionMode="Single"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="240"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PointerReleased="ItemsListBox_PointerReleased"
                         KeyDown="ItemsListBox_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="controls:IconTextDropDownItem">
                            <Border Classes="DropDownItemSurface"
                                    Padding="7,6"
                                    CornerRadius="3"
                                    Cursor="Hand">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Border Width="22"
                                            Height="22"
                                            CornerRadius="3"
                                            Background="{DynamicResource BgToolbar}"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasIcon}">
                                        <PathIcon Data="{Binding Icon}"
                                                  Width="14"
                                                  Height="14"
                                                  Foreground="{DynamicResource TextSecondary}"
                                                  IsVisible="{Binding HasIcon}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                        <TextBlock Text="{Binding Text}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   IsVisible="{Binding HasDescription}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Panel>
</UserControl>
