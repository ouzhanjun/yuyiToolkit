<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:yuyiAvalonia.Base.Controls;assembly=yuyiAvalonia.Base"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="28"
             x:Class="yuyiAvalonia.Base.Controls.LineSpacingComboBox"
             x:Name="This">

    <Border Background="{DynamicResource BgInput}"
            CornerRadius="{DynamicResource CornerRadius}"
            Padding="-2"
            Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}"
            BorderBrush="{DynamicResource BorderColor}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ClipToBounds="True"
            BorderThickness="{DynamicResource BorderThickness}">
        <ComboBox x:Name="PART_ComboBox"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            BorderBrush="Transparent"
            FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
            ItemsSource="{Binding Source={x:Static controls:LineSpacingItem.Items}}"
            SelectionChanged="OnSelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" FontSize="10"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Border>
</UserControl>
