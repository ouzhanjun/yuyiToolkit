<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:common="using:yuyiAvalonia.Base.Controls.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="28"
             x:Class="yuyiAvalonia.Base.Controls.ThreeButtonGroup"
             x:Name="This">
    
    <common:PropertyBorder Background="{DynamicResource BgProperty}"
        x:Name="PART_PropertyBorder"
        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}"
        ClipToBounds="True">
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="1">
            <Border ClipToBounds="True" Grid.Column="0" Padding="-2" CornerRadius="3,0,0,3">
                <Button x:Name="PART_Button1"
                        ToolTip.Tip="{Binding Tip1, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource TextSecondary}"
                        FontFamily="Segoe MDL2 Assets, Consolas"
                        FontSize="11"
                        Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
				    <PathIcon Data="{Binding Icon1, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource TextSecondary}" Width="12" ToolTip.Tip="{Binding Text}"/>
                </Button>
            </Border>
            <Border ClipToBounds="True" Grid.Column="1" Padding="-2" CornerRadius="0,0,0,0">
                <Button x:Name="PART_Button2"
                        Grid.Column="2"
                        ToolTip.Tip="{Binding Tip2, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource TextSecondary}"
                        FontFamily="Segoe MDL2 Assets, Consolas"
                        FontSize="11"
                        Padding="4,0"
                        MinWidth="28"
                        Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
				    <PathIcon Data="{Binding Icon2, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource TextSecondary}" Width="12" ToolTip.Tip="{Binding Text}"/>
                </Button>
            </Border>
            <Border ClipToBounds="True" Grid.Column="2" Padding="-2"  CornerRadius="0,3,3,0">
                <Button x:Name="PART_Button3"
                        Grid.Column="4"
                        ToolTip.Tip="{Binding Tip3, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource TextSecondary}"
                        FontFamily="Segoe MDL2 Assets, Consolas"
                        FontSize="11"
                        Padding="4,0"
                        MinWidth="28"
                        Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
				    <PathIcon Data="{Binding Icon3, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{DynamicResource TextSecondary}" Width="12" ToolTip.Tip="{Binding Text}"/>
                </Button>
            </Border>
        </Grid>
    </common:PropertyBorder>
</UserControl>
