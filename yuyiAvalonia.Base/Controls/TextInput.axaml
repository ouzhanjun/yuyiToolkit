<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:common="using:yuyiAvalonia.Base.Controls.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="60"
             x:Class="yuyiAvalonia.Base.Controls.TextInput"
             x:Name="This">
    
        <common:PropertyBorder Background="{DynamicResource BgProperty}"
            x:Name="PART_PropertyBorder"
            CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}"
            ClipToBounds="True">
         <Grid ColumnDefinitions="Auto,*,Auto" x:Name="PART_GridContent">
             <Border
                Grid.Column="0"
                VerticalAlignment="Center"
                ClipToBounds="True">
                <Panel x:Name="PART_PanelIcon">
                    <TextBlock x:Name="PART_Title"
                        Padding="3,0"
                        Foreground="{DynamicResource TextSecondary}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="False"
                        FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <PathIcon x:Name="PART_Icon"
                        Padding="3,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondary}"
                        IsVisible="False"
                        Width="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Height="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Panel>
            </Border>

            <Border Grid.Column="1" ClipToBounds="True" Padding="-3">
                <TextBox x:Name="PART_TextBox"
                    Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Watermark="{Binding Watermark, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    VerticalContentAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    TextAlignment="{Binding TextAlignment, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Padding="6,3,3,3"
                    BorderThickness="0"/>
            </Border>
             
            <Border Grid.Column="2" VerticalAlignment="Center">
				<TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{Binding Suffix, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"/>
            </Border>
        </Grid>
    </common:PropertyBorder>
</UserControl>
