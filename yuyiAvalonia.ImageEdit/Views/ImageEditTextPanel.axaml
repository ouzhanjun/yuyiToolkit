<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://www.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="380"
             xmlns:vm="clr-namespace:yuyiAvalonia.ImageEdit.ViewModels"
             xmlns:models="clr-namespace:yuyiAvalonia.ImageEdit.Models"
             xmlns:controls="clr-namespace:yuyiAvalonia.Base.Controls;assembly=yuyiAvalonia.Base"
             xmlns:imagecontrols="clr-namespace:yuyiAvalonia.ImageEdit.Controls;assembly=yuyiAvalonia.ImageEdit"
             x:DataType="vm:ImageEditViewModel"
             x:Class="yuyiAvalonia.ImageEdit.Views.ImageEditTextPanel">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Classes="UCSettings">
      <TextBlock Text="文字设置" Classes="Title"/>

      <!-- 字体 -->
      <TextBlock Text="字体" Classes="Content"/>
      <ComboBox ItemsSource="{Binding FontNameList}"
                FontSize="11"
                SelectedItem="{Binding CurrentTextSettings.FontFamilyName, Mode=TwoWay}"
                HorizontalAlignment="Stretch" Margin="0,0,0,10"/>

      <!-- 字号 -->
      <TextBlock Text="字号" Classes="Content"/>
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="45"/>
        </Grid.ColumnDefinitions>
        <Slider Minimum="8" Maximum="200"
                Value="{Binding CurrentTextSettings.FontSize, Mode=TwoWay}"
                VerticalAlignment="Center">
        </Slider>
        <TextBlock Grid.Column="1" Text="{Binding CurrentTextSettings.FontSize, StringFormat={}{0:F0}}"
                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
      </Grid>

      <!-- 粗体、斜体、下划线 -->
      <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
        <ToggleSwitch Content="粗体" IsChecked="{Binding CurrentTextSettings.IsBold, Mode=TwoWay}" OnContent="粗体" OffContent="-" Margin="0,0,15,0"/>
        <ToggleSwitch Content="斜体" IsChecked="{Binding CurrentTextSettings.IsItalic, Mode=TwoWay}" OnContent="斜体" OffContent="-" Margin="0,0,15,0"/>
        <ToggleSwitch Content="下划线" IsChecked="{Binding CurrentTextSettings.IsUnderline, Mode=TwoWay}" OnContent="下划线" OffContent="-"/>
      </StackPanel>

      <TextBlock Text="字体颜色" Classes="Content"/>
      <!-- 字体颜色 -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,5">
        <Border Height="30" CornerRadius="3" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                Width="30"
                Background="{Binding CurrentTextSettings.FontColorDisplay}">
        </Border>
        <Button x:Name="ShowColorPickerBtn" Content="🎨" Padding="8,4" Click="ShowColorPickerBtn_Click" Background="{DynamicResource AccentColor}"/>
      </StackPanel>

      <!-- 拾色器面板（点击按钮时显示） -->
       <!--
      <Border x:Name="ColorPickerContainer" IsVisible="False" Margin="0,5,0,10" Background="{DynamicResource BgContent}" CornerRadius="8" Padding="8">
        <controls:ColorPickerPanel x:Name="ColorPicker"/>
      </Border>
      -->
      <!-- 颜色选择器控件 -->
      <controls:ColorSelectorControl x:Name="ColorSelector" Margin="0,5,0,10" />


      <TextBlock Text="在图片上点击可插入文字" Classes="Tips"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
