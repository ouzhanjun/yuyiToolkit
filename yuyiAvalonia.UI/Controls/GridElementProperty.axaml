<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:yuyiAvalonia.Base.Controls;assembly=yuyiAvalonia.Base"
             xmlns:local="using:yuyiAvalonia.UI.Controls"
             xmlns:icon="clr-namespace:yuyiAvalonia.Base.Helpers;assembly=yuyiAvalonia.Base"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="yuyiAvalonia.UI.Controls.GridElementProperty">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel IsVisible="{Binding ElementProperty, Converter={x:Static ObjectConverters.IsNotNull}}">

            <TabControl Padding="5">

                <!-- 基本 -->
                <TabItem Header="基本">
                    <StackPanel Margin="0,10,0,0">

                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10" Padding="8" CornerRadius="3">
                            <local:IdPropertyEditor
                                Id="{Binding ElementProperty.Id, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Icon="{x:Static icon:Icon.Identity}"
                                Title="标识"
                                ShowIdLabel="{Binding ElementProperty.ShowIdLabel, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Opacity="{Binding ElementProperty.Opacity, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                IsElementVisible="{Binding ElementProperty.IsVisible, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Border>

                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10" Padding="8" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="位置"
                                        FontWeight="Bold"
                                        FontSize="12"
                                        Margin="0,0,0,5"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextPrimary}"/>

                                <local:BoundsEditor
                                    Margin="0,0,0,5"
                                    X="{Binding ElementProperty.X, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Y="{Binding ElementProperty.Y, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Width="{Binding ElementProperty.Width, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Height="{Binding ElementProperty.Height, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <local:RotationEditor
                                        Grid.Column="0"
                                        Rotation="{Binding ElementProperty.Rotation, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10" Padding="8" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="布局"
                                        FontWeight="Bold"
                                        FontSize="12"
                                        Margin="0,0,0,5"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextPrimary}"/>

                                <local:PositionEditor
                                    Left="{Binding ElementProperty.Left, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Top="{Binding ElementProperty.Top, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Right="{Binding ElementProperty.Right, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Bottom="{Binding ElementProperty.Bottom, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    FixLeft="{Binding ElementProperty.FixLeft, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    FixTop="{Binding ElementProperty.FixTop, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    FixRight="{Binding ElementProperty.FixRight, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    FixBottom="{Binding ElementProperty.FixBottom, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Margin="0,4,0,0"/>

                                <local:MarginEditor
                                    ElementProperty="{Binding ElementProperty, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                                <local:AlignmentPropertyEditor
                                    HorizontalAlignment="{Binding ElementProperty.HorizontalAlignment, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    VerticalAlignment="{Binding ElementProperty.VerticalAlignment, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </TabItem>

                <!-- 内容 -->
                <TabItem Header="内容">
                    <StackPanel Margin="0,10,0,0">

                        <!-- 网格属性 -->
                        <TextBlock Text="网格属性"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10" Padding="8" CornerRadius="3">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="行数" FontSize="10" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                                        <controls:NumericUpDownEx Value="{Binding ElementProperty.Rows, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" Minimum="1" Maximum="20" Height="28"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="列数" FontSize="10" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                                        <controls:NumericUpDownEx Value="{Binding ElementProperty.Columns, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" Minimum="1" Maximum="20" Height="28"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,5,0">
                                        <TextBlock Text="行间距" FontSize="10" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                                        <controls:NumericUpDownEx Value="{Binding ElementProperty.RowSpacing, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" Minimum="0" Maximum="50" Height="28"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="5,0,0,0">
                                        <TextBlock Text="列间距" FontSize="10" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                                        <controls:NumericUpDownEx Value="{Binding ElementProperty.ColumnSpacing, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" Minimum="0" Maximum="50" Height="28"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="行定义" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                                <local:GridDefinitionEditor
                                    x:Name="PART_RowDefinitionEditor"
                                    Count="{Binding ElementProperty.Rows, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Definition="{Binding ElementProperty.RowDefinitions, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    HintText="设置各行比例"/>

                                <TextBlock Text="列定义" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,5"/>
                                <local:GridDefinitionEditor
                                    x:Name="PART_ColumnDefinitionEditor"
                                    Count="{Binding ElementProperty.Columns, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Definition="{Binding ElementProperty.ColumnDefinitions, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    HintText="设置各列比例"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </TabItem>

                <!-- 外观 -->
                <TabItem Header="外观">
                    <StackPanel Margin="0,10,0,0">

                        <!-- 填充 -->
                        <TextBlock Text="填充"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10" Padding="8" CornerRadius="3">
                            <local:FillPropertyEditor
                                Fill="{Binding ElementProperty.BackgroundFill, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Border>

                        <!-- 阴影属性 -->
                        <TextBlock Text="阴影属性"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10" Padding="8" CornerRadius="3">
                            <local:ShadowPropertyEditor
                                HasShadow="{Binding ElementProperty.HasShadow, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ShadowColor="{Binding ElementProperty.ShadowColor, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ShadowBlur="{Binding ElementProperty.ShadowBlur, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ShadowOffsetX="{Binding ElementProperty.ShadowOffsetX, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ShadowOffsetY="{Binding ElementProperty.ShadowOffsetY, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ShadowSpread="{Binding ElementProperty.ShadowSpread, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                IsInset="{Binding ElementProperty.IsInset, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Border>

                        <!-- 发光属性 -->
                        <TextBlock Text="发光属性"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10" Padding="8" CornerRadius="3">
                            <local:GlowPropertyEditor
                                HasGlow="{Binding ElementProperty.HasGlow, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                GlowColor="{Binding ElementProperty.GlowColor, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                GlowBlurRadius="{Binding ElementProperty.GlowBlurRadius, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                GlowOffsetX="{Binding ElementProperty.GlowOffsetX, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                GlowOffsetY="{Binding ElementProperty.GlowOffsetY, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                GlowOpacity="{Binding ElementProperty.GlowOpacity, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Border>

                    </StackPanel>
                </TabItem>

                <TabItem Header="描边">
                    <StackPanel Margin="0,10,0,0">
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10" Padding="8" CornerRadius="3">
                            <local:StrokeEditor x:Name="StrokeEditorCtrl"
                                StrokeFills="{Binding ElementProperty.StrokeFills, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                StrokeDashOffset="{Binding ElementProperty.StrokeDashOffset, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                StrokeWidth="{Binding ElementProperty.StrokeWidth, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                StrokeType="{Binding ElementProperty.StrokeType, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                StrokeStyle="{Binding ElementProperty.StrokeStyle, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                StrokePosition="{Binding ElementProperty.StrokePosition, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                StrokeEndpoint="{Binding ElementProperty.StrokeEndpoint, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                StrokeJoin="{Binding ElementProperty.StrokeJoin, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                StrokeMiterLimit="{Binding ElementProperty.StrokeMiterLimit, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                StrokeDashArrayString="{Binding ElementProperty.StrokeDashArrayString, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Opacity="{Binding ElementProperty.StrokeOpacity, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                StrokeColor="{Binding ElementProperty.StrokeColor, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- 填充 -->
                <TabItem Header="填充">
                    <StackPanel Margin="0,10,0,0">
                        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10" Padding="8" CornerRadius="3">
                            <local:FillEditor x:Name="FillEditorCtrl"/>
                        </Border>
                    </StackPanel>
                </TabItem>

            </TabControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
