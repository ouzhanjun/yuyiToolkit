<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="using:yuyiAvalonia.UI.Models"
             xmlns:control="using:yuyiAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
             x:Class="yuyiAvalonia.UI.Controls.ElementTreeControl"
             x:DataType="model:ElementTreeViewModel">

    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 工具栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgToolbar}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="0"
                Padding="8,6"
                Margin="3"     
                >
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="全部展开"
                        Padding="8,4"
                        FontSize="11"
                        Click="ExpandAll_Click"/>
                <Button Content="全部折叠"
                        Padding="8,4"
                        FontSize="11"
                        Click="CollapseAll_Click"/>
                <Button Content="刷新"
                        Padding="8,4"
                        FontSize="11"
                        Click="Refresh_Click"/>
            </StackPanel>
        </Border>

        <!-- 空状态 -->
        <Border IsVisible="{Binding !RootItems.Count}"
                Grid.Row="1"          
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <TextBlock Text="画布上暂无元素"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       Opacity="0.5"/>
        </Border>

        <!-- 树形列表 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            IsVisible="{Binding RootItems.Count}">
            <ItemsControl ItemsSource="{Binding RootItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="control:ElementTreeItem">
                        <control:ElementTreeNode DataContext="{Binding}"
                                            ItemSelected="OnItemSelected"
                                            ItemCtrlSelected="OnItemCtrlSelected"
                                            ItemShiftSelected="OnItemShiftSelected"
                                            VisibilityToggled="OnVisibilityToggled"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
