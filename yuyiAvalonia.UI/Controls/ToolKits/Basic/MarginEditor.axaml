<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:common="using:yuyiAvalonia.Base.Controls.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icon="using:yuyiAvalonia.Base.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:yuyiAvalonia.Base.Controls;assembly=yuyiAvalonia.Base"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="200"
             x:Class="yuyiAvalonia.UI.Controls.MarginEditor">

    <StackPanel Margin="0,0,0,5">
        <TextBlock Grid.Column="0" Margin="0,0,0,5" Text="外边距" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>

        <Grid ColumnDefinitions="*,30" RowDefinitions="*,*" ColumnSpacing="1" RowSpacing="1">
            <!-- 统一模式：始终可见 -->
            <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="80,*" ColumnSpacing="1">
                <controls:NumericUpDownEx
                    x:Name="PART_Margin"
                    Grid.Column="0"
                    Title="Margin"
                    CornerRadius="3,0,0,3"
                    Value="{Binding Margin, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Icon="{x:Static icon:Icon.MarginDiff}"
                    Minimum="0" Maximum="100" Height="28"/>
                <common:PropertyBorder Background="{DynamicResource BgProperty}"
                    Grid.Column="1"
                    Height="28"
                    CornerRadius="0,3,3,0"
                    x:Name="PART_PropertyBorder"
                    Padding="3,0,3,0"
                    ClipToBounds="True">
                    <Slider x:Name="PART_Slider_Margin"
                        Margin="0,-9,0,0"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding Margin, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        VerticalAlignment="Center"/>
                </common:PropertyBorder>
            </Grid>

            <controls:MarginTypeButtonGroup
                Grid.Column="1"
                Grid.Row="0"
                VerticalAlignment="Top"
                UniformIcon="{x:Static icon:Icon.MarginDiff}"
                Width="28" Height="28"
                IsUniform="{Binding IsShowMarginIsUniform, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <!-- 分别设置模式 -->
            <Grid Grid.Row="1" Grid.Column="0"
                IsVisible="{Binding IsShowMarginIsUniform, RelativeSource={RelativeSource AncestorType=UserControl}}"
                ColumnSpacing="1"
                RowSpacing="1"
                ColumnDefinitions="*,*"
                RowDefinitions="*,*">
                <StackPanel Grid.Column="0" Grid.Row="0">
                    <controls:NumericUpDownEx
                        CornerRadius="3,0,0,0"
                        Title="L"
                        Icon="{x:Static icon:Icon.L_M}"
                        Value="{Binding MarginLeft, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Minimum="0" Maximum="100" Height="28"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0">
                    <controls:NumericUpDownEx
                        CornerRadius="0,3,0,0"
                        Title="T"
                        Icon="{x:Static icon:Icon.T_M}"
                        Value="{Binding MarginTop, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Minimum="0" Maximum="100" Height="28"/>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="1">
                    <controls:NumericUpDownEx
                        CornerRadius="0,0,0,3"
                        Title="R"
                        Icon="{x:Static icon:Icon.R_M}"
                        Value="{Binding MarginRight, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Minimum="0" Maximum="100" Height="28"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1">
                    <controls:NumericUpDownEx
                        CornerRadius="0,0,3,0"
                        Title="B"
                        Icon="{x:Static icon:Icon.B_M}"
                        Value="{Binding MarginBottom, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Minimum="0" Maximum="100" Height="28"/>
                </StackPanel>
            </Grid>

        </Grid>
    </StackPanel>
</UserControl>
