<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:yuyiAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="120"
             x:Class="yuyiAvalonia.UI.Controls.StrokeDashArrayEditor">

    <StackPanel>
        <!-- 标题和当前值显示 -->
        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding HintText, RelativeSource={RelativeSource AncestorType=local:StrokeDashArrayEditor}}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding CurrentDashArrayDisplay, RelativeSource={RelativeSource AncestorType=local:StrokeDashArrayEditor}}"
                       FontSize="11"
                       Foreground="{DynamicResource AccentColor}"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>
        </Grid>

        <!-- 输入区域 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource BgProperty}"
                    CornerRadius="3"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    Height="28">
                <TextBox Grid.Column="0"
                         x:Name="PART_DashArrayTextBox"
                         Text="{Binding DashArrayDefinition, RelativeSource={RelativeSource AncestorType=local:StrokeDashArrayEditor}, Mode=TwoWay}"
                         Watermark="8,4 或 4,2,1,2"
                         FontSize="11"
                         Height="28"
                         MinWidth="150"/>
            </Border>

            <!-- 自动生成按钮 -->
            <Button Grid.Column="1"
                    x:Name="PART_AutoGenerateButton"
                    Content="自动"
                    Margin="5,0,0,0"
                    Padding="8,4"
                    FontSize="11"
                    ToolTip.Tip="根据选择的样式自动生成虚线数组"/>

            <!-- 应用按钮 -->
            <Button Grid.Column="2"
                    x:Name="PART_ApplyButton"
                    Content="应用"
                    Margin="5,0,0,0"
                    Padding="8,4"
                    FontSize="11"
                    ToolTip.Tip="验证并应用当前虚线数组"/>
        </Grid>

        <!-- 错误消息显示 -->
        <TextBlock x:Name="PART_ErrorTextBlock"
                   FontSize="9"
                   Foreground="#FF5555"
                   Margin="0,3,0,0"
                   IsVisible="False"
                   TextWrapping="Wrap"/>

        <!-- 格式说明 -->
        <TextBlock FontSize="9"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,5,0,0"
                   TextWrapping="Wrap">
            <Run Text="格式说明: 数字,数字,... (偶数个值效果最佳)"/>
        </TextBlock>

        <!-- 预览区域 -->
        <Border Margin="0,8,0,0"
                Height="24"
                Background="{DynamicResource BgToolbar}"
                CornerRadius="3"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                ClipToBounds="True">
            <Canvas x:Name="PART_PreviewCanvas" Margin="4,0">
                <Line x:Name="PART_PreviewLine"
                      StartPoint="4,12"
                      EndPoint="900,12"
                      Stroke="{DynamicResource AccentColor}"
                      StrokeThickness="2"
                      StrokeDashArray="{Binding DashArrayForPreview, RelativeSource={RelativeSource AncestorType=local:StrokeDashArrayEditor}}"/>
            </Canvas>
        </Border>
    </StackPanel>
</UserControl>
