<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:common="using:yuyiAvalonia.Base.Controls.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icon="using:yuyiAvalonia.Base.Helpers"
             xmlns:local="using:yuyiAvalonia.Base.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="80" d:DesignHeight="28"
             x:Class="yuyiAvalonia.UI.Controls.ColorSpecUpDownEx"
             x:Name="This">
    <Panel>
    <common:PropertyBorder Background="{DynamicResource BgProperty}"
        x:Name="PART_PropertyBorder"
        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}"
        ClipToBounds="True">
            <Grid ColumnDefinitions="*,1,Auto" x:Name="PART_GridContent">
                <local:ColorInput Grid.Column="0" IsFrontColor="True" 
                    Text="{Binding FillColor, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                    OpacityValue="{Binding OpacityPercent, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CornerRadius="0"
                    Width="120" FontSize="11" Height="30"/>
               
                <local:NumericPercentUpDownEx
                    x:Name="numOpacity"
                    Grid.Column="2"
                    Title="透明度"
                    Icon="{x:Static icon:Icon.Opacity}"
                    Minimum="0"
                    Maximum="100"
                    Suffix="%"
                    Step="1"
                    FontSize="10"
                    Width="80"
                    Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CornerRadius="0"                    
                    Value="{Binding OpacityPercent, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    VerticalAlignment="Center"/>
            </Grid>
        </common:PropertyBorder>
    </Panel>
</UserControl>
