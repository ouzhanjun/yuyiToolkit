<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:common="using:yuyiAvalonia.Base.Controls.Common"
             xmlns:controls="using:yuyiAvalonia.Base.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="120" d:DesignHeight="60"
             x:Class="yuyiAvalonia.UI.Controls.SimpleColorInput"
             x:Name="This">
    
    <common:PropertyBorder Background="{DynamicResource BgProperty}"
        x:Name="PART_PropertyBorder"
        CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}"
        ClipToBounds="True">
        <Panel x:Name="Part_ColorPanel" ClipToBounds="True">
            <Border Padding="-3">
                <TextBox x:Name="PART_TextBox"
                    Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Left"
                    TextAlignment="Left"
                    Background="Transparent"
                    Padding="6,3,28,3"/>
            </Border>
            <Panel HorizontalAlignment="Right"
                x:Name="PART_ColorPanel"
                Margin="-2,-2,8,-2"
                Width="16"
                Height="16"
                Cursor="Hand"
                PointerPressed="ColorPreview_Click">
                <Border x:Name="PART_ColorPreview"
                    BorderBrush="Transparent"
                    BorderThickness="1" 
                    ClipToBounds="True"
                    CornerRadius="3"
                    Width="16"
                    Height="16">
                </Border>
                <Border 
                    CornerRadius="3"
                    Cursor="Hand"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" 
                    Width="16"
                    Height="16"
                    Background="Transparent"
                    ClipToBounds="True">
                </Border>
            </Panel>
        </Panel>
    </common:PropertyBorder>
</UserControl>
