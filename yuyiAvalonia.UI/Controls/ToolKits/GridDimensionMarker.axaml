<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:yuyiAvalonia.Base.Controls;assembly=yuyiAvalonia.Base"
             xmlns:local="using:yuyiAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="150"
             x:Class="yuyiAvalonia.UI.Controls.GridDimensionMarker">

    <UserControl.Resources>
        <local:GridDimensionMarker x:Key="selfReference"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RenderTransform>
            <TranslateTransform/>
        </Grid.RenderTransform>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 左上角空白 -->
        <Border Grid.Column="0" Grid.Row="0" Width="24" Height="24" Background="Transparent"/>

        <!-- 顶部行尺寸标注区域 -->
        <ItemsControl Grid.Column="1" Grid.Row="0"
                      x:Name="PART_RowMarkers"
                      VerticalAlignment="Top"
                      Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource BgContent}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="4,2"
                            Margin="1,0"
                            MinWidth="40"
                            Cursor="Hand">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DisplayText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Index, StringFormat='{}{0}'}"
                                       FontSize="8"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 左侧列尺寸标注区域 -->
        <ItemsControl Grid.Column="0" Grid.Row="1"
                      x:Name="PART_ColumnMarkers"
                      HorizontalAlignment="Left"
                      Margin="4,0,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Margin="0,0,5,0"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource BgContent}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="4,2"
                            Margin="0,1"
                            MinHeight="30"
                            Cursor="Hand">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DisplayText}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Index, StringFormat='{}{0}'}"
                                       FontSize="8"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 中间编辑区域 - 可选浮层 -->
        <Border Grid.Column="1" Grid.Row="1"
                x:Name="PART_EditOverlay"
                Background="{DynamicResource BgHover}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                IsVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <!-- 数值输入 -->
                <controls:NumericUpDownEx x:Name="PART_ValueInput"
                                          Width="80"
                                          Height="28"
                                          Minimum="0"
                                          Maximum="10000"/>

                <!-- 锁定按钮 -->
                <ToggleButton x:Name="PART_LockButton"
                              Width="28" Height="28"
                              ToolTip.Tip="锁定/解锁尺寸"
                              IsChecked="{Binding IsLockChecked, Source={x:Static local:GridDimensionMarker.StaticLockState}}"
                              Click="OnLockButtonClick">
                    <Panel>
                        <!-- 解锁状态 -->
                        <Path x:Name="UnlockedIcon"
                              Data="M6,19 C6,20.1 6.9,21 8,21 H16 C17.1,21 18,20.1 18,19 V13 L21,10 V7 L20,8 L17,5 V5 C17,3.9 16.1,3 15,3 C13.9,3 13,3.9 13,5 M11.5,5 L6.8,9.7 C6.2,10.3 6,11.1 6,12 L6,19 C6,20.1 6.9,21 8,21 H15 C16.1,21 17,20.1 17,19 V14.5 L18.5,13 L19,14 L17.5,15.5 V19 C17.5,20.6 16.2,21.9 14.6,21.9 L8.5,21.9 C6.9,21.9 5.5,20.6 5.5,19"
                              Fill="{DynamicResource TextSecondary}"
                              StrokeThickness="0"/>
                        <!-- 锁定状态 -->
                        <Path x:Name="LockedIcon"
                              Data="M18,8 V5 C18,3.9 17.1,3 16,3 C14.9,3 14,3.9 14,5 L14,8 L12,10 V13 L10,15 V18 L14,22 H18 C19.1,22 20,21.1 20,20 V8 M16,18 C15.4,18 15,17.6 15,17 C15,16.4 15.4,16 16,16 C16.6,16 17,16.4 17,17 C17,17.6 16.6,18 16,18 M18,7 L14,11"
                              Fill="{DynamicResource AccentColor}"
                              StrokeThickness="0"
                              IsVisible="False"/>
                    </Panel>
                </ToggleButton>

                <!-- 比例按钮 -->
                <ToggleButton x:Name="PART_RatioButton"
                              Width="28" Height="28"
                              ToolTip.Tip="切换比例模式"
                              IsChecked="{Binding IsRatioChecked, Source={x:Static local:GridDimensionMarker.StaticLockState}}">
                    <TextBlock Text="*"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ToggleButton>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
