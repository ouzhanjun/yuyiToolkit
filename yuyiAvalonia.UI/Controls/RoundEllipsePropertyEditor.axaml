<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:common="using:yuyiAvalonia.Base.Controls.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icon="using:yuyiAvalonia.Base.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:yuyiAvalonia.Base.Controls;assembly=yuyiAvalonia.Base"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="yuyiAvalonia.UI.Controls.RoundEllipsePropertyEditor">

    <StackPanel Margin="0,0,0,5" Spacing="5">

        <TextBlock Text="椭圆"
                Grid.Column="0"
                FontWeight="Bold"
                FontSize="12"
                Margin="0,0,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextPrimary}"/>

        <!-- 第一行：起始角 + 扫描角 -->
        <Grid ColumnDefinitions="*,*,30" ColumnSpacing="1">
            <StackPanel Grid.Column="0">
                <TextBlock Text="起始角" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,0,5"/>
                <controls:NumericSpecUpDownEx
                    x:Name="PART_StartAngle"
                    Icon="{x:Static icon:Icon.StartAngle}"
                    Title="起始角"
                    Suffix="°"
                    ButtonIcon="{x:Static icon:Icon.Slider}"
                    UseSlider="True"
                    NeedUpDown="False"
                    CornerRadius="3,0,0,3"
                    Value="{Binding StartAngle, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Minimum="-360" Maximum="720" Height="28"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="扫描角" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,0,5"/>
                <controls:NumericSpecUpDownEx
                    x:Name="PART_SweepAngle"
                    Icon="{x:Static icon:Icon.StartAngle}"
                    Title="扫描角"
                    ButtonIcon="{x:Static icon:Icon.Slider}"
                    UseSlider="True"
                    Suffix="°"
                    NeedUpDown="False"
                    CornerRadius="0,3,3,0"
                    Value="{Binding SweepAngle, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Minimum="-360" Maximum="360" Height="28"/>
            </StackPanel>
        </Grid>

        <!-- 第二行：内圈占比 -->
        <Grid ColumnDefinitions="80,*,30" ColumnSpacing="1">
            <StackPanel Grid.Column="0">
                <TextBlock Text="内圈占比" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,0,5"/>
                <controls:NumericUpDownEx
                    x:Name="PART_InnerRadius"
                    Icon="{x:Static icon:Icon.Ratio}"
                    Title="内圈"
                    NeedUpDown="False"
                    DecimalPlaces="2"
                    Step="0.01"
                    CornerRadius="3,0,0,3"
                    Value="{Binding InnerRadius, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Minimum="0" Maximum="0.95" Height="28"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="" FontSize="11" Margin="0,0,0,5"/>
                <common:PropertyBorder
                    x:Name="PART_InnerRadiusBorder"
                    Background="{DynamicResource BgProperty}"
                    CornerRadius="0,3,3,0"
                    Height="28"
                    Padding="3,0,3,0"
                    ClipToBounds="True">
                    <Slider x:Name="PART_Slider_InnerRadius"
                        Margin="0,-9,0,0"
                        Minimum="0"
                        Maximum="0.95"
                        TickFrequency="0.01"
                        Value="{Binding InnerRadius, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        VerticalAlignment="Center"/>
                </common:PropertyBorder>
            </StackPanel>
        </Grid>

        <!-- 第三行：圆角半径 -->
        <Grid ColumnDefinitions="80,*,30" ColumnSpacing="1">
            <StackPanel Grid.Column="0">
                <TextBlock Text="圆角半径" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,0,5"/>
                <controls:NumericUpDownEx
                    x:Name="PART_CornerRadius"
                    Icon="{x:Static icon:Icon.CornerRadius}"
                    Title="圆角"
                    CornerRadius="3,0,0,3"
                    Value="{Binding CornerRadius, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Minimum="0" Maximum="60" Height="28"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="" FontSize="11" Margin="0,0,0,5"/>
                <common:PropertyBorder
                    x:Name="PART_CornerRadiusBorder"
                    Background="{DynamicResource BgProperty}"
                    CornerRadius="0,3,3,0"
                    Height="28"
                    Padding="3,0,3,0"
                    ClipToBounds="True">
                    <Slider x:Name="PART_Slider_CornerRadius"
                        Margin="0,-9,0,0"
                        Minimum="0"
                        Maximum="60"
                        Value="{Binding CornerRadius, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        VerticalAlignment="Center"/>
                </common:PropertyBorder>
            </StackPanel>
        </Grid>

        <!-- 快捷预设 -->
        <TextBlock Text="快捷预设"
                FontWeight="Bold"
                FontSize="12"
                Margin="0,5,0,5"
                Foreground="{DynamicResource TextPrimary}"/>
        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="5" CornerRadius="3">
            <WrapPanel>
                <Button Click="BtnSectorFull_Click"       Margin="0,0,6,6" Padding="6,4" ToolTip.Tip="椭圆">
                    <PathIcon Data="{x:Static icon:Icon.Ellipse}" Width="16" Height="16"
                              Foreground="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Button Click="BtnSectorHalf_Click"       Margin="0,0,6,6" Padding="6,4" ToolTip.Tip="半圆">
                    <PathIcon Data="{x:Static icon:Icon.Semicircle}" Width="16" Height="16"
                              Foreground="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Button Click="BtnSectorPie_Click"        Margin="0,0,6,6" Padding="6,4" ToolTip.Tip="扇形">
                    <PathIcon Data="{x:Static icon:Icon.Sector}" Width="16" Height="16"
                              Foreground="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Button Click="BtnSectorRing_Click"       Margin="0,0,6,6" Padding="6,4" ToolTip.Tip="圆环">
                    <PathIcon Data="{x:Static icon:Icon.Ring}" Width="16" Height="16"
                              Foreground="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Button Click="BtnSectorRingSector_Click" Margin="0,0,6,6" Padding="6,4" ToolTip.Tip="扇环">
                    <PathIcon Data="{x:Static icon:Icon.CircularSector}" Width="16" Height="16"
                              Foreground="{Binding $parent[Button].Foreground}"/>
                </Button>
            </WrapPanel>
        </Border>

        <TextBlock x:Name="SectorInfoText"
                Foreground="{DynamicResource TextSecondary}"
                FontSize="11"
                TextWrapping="Wrap"
                Margin="0,5,0,0"/>

        <!-- 调试点显示控制 -->
        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="8" CornerRadius="3">
            <StackPanel Spacing="8">
                <TextBlock Text="调试点显示"
                       FontWeight="Bold"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"/>

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <!-- 总开关 -->
                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Content="显示调试点"
                        IsChecked="{Binding DrawPoint, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,5"/>

                    <!-- 图形点 -->
                    <Ellipse Grid.Row="1" Grid.Column="0" Width="12" Height="12"
                            Fill="#1E88E5" Stroke="#1565C0" StrokeThickness="1"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="1" Grid.Column="1"
                        Content="图形点（顶点）"
                        IsChecked="{Binding DrawVertex, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,3"/>

                    <!-- 虚线连接 -->
                    <Border Grid.Row="2" Grid.Column="0" Width="12" Height="12"
                            BorderBrush="#1E88E5" BorderThickness="1"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <RotateTransform Angle="45"/>
                        </Border.RenderTransform>
                    </Border>
                    <CheckBox Grid.Row="2" Grid.Column="1"
                        Content="顶点虚线连接"
                        IsChecked="{Binding DrawVertexLine, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,3"/>

                    <!-- 控制点 -->
                    <Ellipse Grid.Row="3" Grid.Column="0" Width="12" Height="12"
                            Fill="#FFEB3B" Stroke="#F57F17" StrokeThickness="1"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="3" Grid.Column="1"
                        Content="控制点（切点）"
                        IsChecked="{Binding DrawTangent, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,3"/>

                    <!-- 圆心 -->
                    <Ellipse Grid.Row="4" Grid.Column="0" Width="12" Height="12"
                            Fill="#FF9800" Stroke="#E65100" StrokeThickness="1"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="4" Grid.Column="1"
                        Content="圆心"
                        IsChecked="{Binding DrawCenter, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
