<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:common="using:yuyiAvalonia.Base.Controls.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icon="using:yuyiAvalonia.Base.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:yuyiAvalonia.Base.Controls;assembly=yuyiAvalonia.Base"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="700"
             x:Class="yuyiAvalonia.UI.Controls.RoundedRectangleShapeEditor">

    <StackPanel Margin="0,0,0,5">
        
        <TextBlock Text="圆角"
                Grid.Column="0"
                FontWeight="Bold"
                FontSize="12"
                Margin="0,0,0,5" 
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextPrimary}"/>

        <Grid ColumnDefinitions="*,30" RowDefinitions="*,*" ColumnSpacing="1" RowSpacing="1">

            <!-- 统一模式输入：始终可见 -->
            <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="80,*" ColumnSpacing="1">
                <controls:NumericUpDownEx
                    x:Name="PART_UnifiedInput"
                    Grid.Column="0"
                    Title="圆角"
                    CornerRadius="3,0,0,3"
                    Icon="{x:Static icon:Icon.CornerRadius}"
                    Value="{Binding CornerRadius, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Minimum="0" Maximum="120" Height="28"/>
                <common:PropertyBorder Grid.Column="1"
                    x:Name="PART_PropertyBorder"
                    Background="{DynamicResource BgProperty}"
                    CornerRadius="0,3,3,0"
                    Height="28"
                    Padding="3,0,3,0"
                    ClipToBounds="True">
                    <Slider x:Name="PART_Slider_Unified"
                        Margin="0,-9,0,0"
                        Minimum="0"
                        Maximum="120"
                        TickFrequency="1"
                        Value="{Binding CornerRadius, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        VerticalAlignment="Center"/>
                </common:PropertyBorder>
            </Grid>

            <!-- 切换按钮：绑定到中间属性 IsShowCornerRadiusIsUniform -->
            <controls:MarginTypeButtonGroup
                x:Name="PART_MarginTypeButton"
                Grid.Column="1"
                Grid.Row="0"
                CornerRadius="3"
                VerticalAlignment="Top"
                UniformIcon="{x:Static icon:Icon.CornerRadius}"
                Width="28" Height="28"
                IsUniform="{Binding IsShowCornerRadiusIsUniform, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <!-- 分开模式 Grid：绑定到中间属性 -->
            <Grid Grid.Row="1" Grid.Column="0"
                IsVisible="{Binding IsShowCornerRadiusIsUniform, RelativeSource={RelativeSource AncestorType=UserControl}}"
                ColumnSpacing="1"
                RowSpacing="1"
                ColumnDefinitions="*,*"
                RowDefinitions="*,*">
                <StackPanel Grid.Column="0" Grid.Row="0">
                    <controls:NumericUpDownEx
                        x:Name="PART_LT"
                        CornerRadius="3,0,0,0"
                        Title="LT"
                        Icon="{x:Static icon:Icon.LTRadius}"
                        Value="{Binding CornerRadiusLT, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Minimum="0" Maximum="120" Height="28"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="0">
                    <controls:NumericUpDownEx
                        x:Name="PART_RT"
                        CornerRadius="0,3,0,0"
                        Title="RT"
                        Icon="{x:Static icon:Icon.RTRadius}"
                        Value="{Binding CornerRadiusRT, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Minimum="0" Maximum="120" Height="28"/>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="1">
                    <controls:NumericUpDownEx
                        x:Name="PART_LB"
                        CornerRadius="0,0,0,3"
                        Title="LB"
                        Icon="{x:Static icon:Icon.LBRadius}"
                        Value="{Binding CornerRadiusLB, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Minimum="0" Maximum="120" Height="28"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="1">
                    <controls:NumericUpDownEx
                        x:Name="PART_RB"
                        CornerRadius="0,0,3,0"
                        Title="RB"
                        Icon="{x:Static icon:Icon.RBRadius}"
                        Value="{Binding CornerRadiusRB, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Minimum="0" Maximum="120" Height="28"/>
                </StackPanel>
            </Grid>

        </Grid>

        <!-- 调试点显示控制 -->
        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="8" CornerRadius="3" Margin="0,5,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="调试点显示"
                       FontWeight="Bold"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"/>

                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <!-- 总开关 -->
                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Content="显示调试点"
                        IsChecked="{Binding DrawPoint, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,5"/>

                    <!-- 图形点 -->
                    <Ellipse Grid.Row="1" Grid.Column="0" Width="12" Height="12"
                            Fill="#1E88E5" Stroke="#1565C0" StrokeThickness="1"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="1" Grid.Column="1"
                        Content="图形点（顶点）"
                        IsChecked="{Binding DrawVertex, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,3"/>

                    <!-- 虚线连接 -->
                    <Border Grid.Row="2" Grid.Column="0" Width="12" Height="12"
                            BorderBrush="#1E88E5" BorderThickness="1"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <RotateTransform Angle="45"/>
                        </Border.RenderTransform>
                    </Border>
                    <CheckBox Grid.Row="2" Grid.Column="1"
                        Content="顶点虚线连接"
                        IsChecked="{Binding DrawVertexLine, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,3"/>

                    <!-- 控制点 -->
                    <Ellipse Grid.Row="3" Grid.Column="0" Width="12" Height="12"
                            Fill="#FFEB3B" Stroke="#F57F17" StrokeThickness="1"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="3" Grid.Column="1"
                        Content="控制点（切点）"
                        IsChecked="{Binding DrawTangent, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Margin="0,0,0,3"/>

                    <!-- 圆心 -->
                    <Ellipse Grid.Row="4" Grid.Column="0" Width="12" Height="12"
                            Fill="#FF9800" Stroke="#E65100" StrokeThickness="1"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="4" Grid.Column="1"
                        Content="圆心"
                        IsChecked="{Binding DrawCenter, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
