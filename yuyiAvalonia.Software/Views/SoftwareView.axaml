<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:yuyiAvalonia.Software.ViewModels;assembly=yuyiAvalonia.Software"
             xmlns:models="clr-namespace:yuyiAvalonia.Software.Models;assembly=yuyiAvalonia.Software"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="yuyiAvalonia.Software.Views.SoftwareView"
             x:DataType="vm:SoftwareViewModel">
    <Grid Background="{DynamicResource BgToolbar}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="{DynamicResource BgContent}" CornerRadius="6" Padding="12" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="添加软件" Command="{Binding AddSoftwareCommand}" Padding="12,6"
                            Background="{DynamicResource AccentColor}" FontWeight="Medium"/>
                    <Button Content="批量下载" Command="{Binding BatchDownloadCommand}" Padding="12,6" ToolTip.Tip="批量下载选中的软件"/>
                    <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="12,6" ToolTip.Tip="刷新软件列表"/>
                    <Button Content="下载管理" Command="{Binding OpenDownloadManagerCommand}" Padding="12,6" ToolTip.Tip="打开下载管理器"/>
                </StackPanel>

                <TextBox Grid.Column="1" Text="{Binding SearchKeyword}" Watermark="搜索软件..."
                         Margin="16,0" VerticalContentAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CurrentCategory}" MinWidth="100"/>
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" MinWidth="80"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧软件列表 -->
            <Border Grid.Column="0" Background="{DynamicResource BgContent}" CornerRadius="6" Margin="0,0,6,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="软件列表" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimary}"/>
                            <Border Background="{DynamicResource AccentColor}" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding FilteredSoftware.Count, StringFormat='{}{0}'}" FontSize="11" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding AllSoftware.Count, StringFormat='共 {0} 个软件'}" FontSize="11" Opacity="0.6" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- 筛选标签 -->
                    <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" Margin="8,0,8,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch Content="仅收藏" IsChecked="{Binding ShowOnlyFavorites}" OnContent="是" OffContent="否"/>
                            <ToggleSwitch Content="已下载" IsChecked="{Binding ShowOnlyDownloaded}" OnContent="是" OffContent="否"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer>
                        <ListBox ItemsSource="{Binding FilteredSoftware}" SelectedItem="{Binding SelectedSoftware}" Background="Transparent" BorderThickness="0" Margin="6">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource HoverColor}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="Opacity" Value="0.85"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:SoftwareItem">
                                    <Border CornerRadius="6" Margin="4,2" Padding="10,10" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <!-- 状态指示器 -->
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                        <Ellipse.Fill>
                                                            <SolidColorBrush Color="{Binding Status, Converter={x:Static vm:StatusToColorConverter.Instance}}"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                                    <Border Background="#1A1890FF" CornerRadius="2" Padding="4,1" IsVisible="{Binding IsBuiltIn}" ToolTip.Tip="内置软件">
                                                        <TextBlock Text="内置" FontSize="9" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="★" FontSize="12" Foreground="#FAAD14" IsVisible="{Binding IsFavorite}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,4,0,0">
                                                    <TextBlock Text="{Binding Version}" FontSize="11" Opacity="0.6" Foreground="{DynamicResource TextPrimary}"/>
                                                    <Border Background="{DynamicResource AccentColor}" Opacity="0.2" CornerRadius="3" Padding="6,2">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Size}" FontSize="11" Opacity="0.5" Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 操作按钮 -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Classes="FlatButton" Padding="6,4" ToolTip.Tip="收藏"
                                                        Command="{Binding ToggleFavoriteCommand, Source={x:Static vm:SoftwareViewModel.Instance}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="☆" FontSize="16"/>
                                                </Button>
                                                <Button Classes="FlatButton" Padding="6,4" ToolTip.Tip="下载"
                                                        Command="{Binding DownloadSoftwareCommand, Source={x:Static vm:SoftwareViewModel.Instance}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="↓" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 右侧详情区 -->
            <Border Grid.Column="1" Background="{DynamicResource BgContent}" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 详情头部 -->
                    <Border Grid.Row="0" Background="{DynamicResource BgToolbar}" CornerRadius="6" Padding="16" Margin="12,12,12,0"
                            IsVisible="{Binding SelectedSoftware, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- 软件图标 -->
                            <Border Grid.Column="0" Width="64" Height="64" Background="{DynamicResource AccentColor}" CornerRadius="8" Margin="0,0,16,0">
                                <TextBlock Text="{Binding SelectedSoftware.Name[0]}" FontSize="28" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 软件基本信息 -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding SelectedSoftware.Name}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>
                                    <Border Background="{DynamicResource AccentColor}" CornerRadius="4" Padding="8,2" IsVisible="{Binding SelectedSoftware.IsBuiltIn}">
                                        <TextBlock Text="内置" FontSize="10" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="版本:" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding SelectedSoftware.Version}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="分类:" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding SelectedSoftware.Category}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="大小:" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding SelectedSoftware.Size}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="发布者:" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding SelectedSoftware.Publisher, TargetNullValue='未知'}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- 操作按钮组 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="FlatButton" Padding="10,6" ToolTip.Tip="打开官网"
                                        Command="{Binding OpenWebsiteCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="🌐" FontSize="14"/>
                                        <TextBlock Text="官网" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="AccentButton" Padding="12,6" ToolTip.Tip="下载软件"
                                        Command="{Binding DownloadSoftwareCommand}"
                                        IsEnabled="{Binding !IsDownloading}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="↓" FontSize="14"/>
                                        <TextBlock Text="下载" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="FlatButton" Padding="10,6" ToolTip.Tip="编辑软件"
                                        Command="{Binding StartEditCommand}"
                                        CommandParameter="{Binding SelectedSoftware}"
                                        IsVisible="{Binding !SelectedSoftware.IsBuiltIn}">
                                    <TextBlock Text="✎" FontSize="14"/>
                                </Button>
                                <Button Classes="FlatButton" Padding="10,6" ToolTip.Tip="删除软件"
                                        Command="{Binding DeleteSoftwareCommand}"
                                        CommandParameter="{Binding SelectedSoftware}"
                                        IsVisible="{Binding !SelectedSoftware.IsBuiltIn}">
                                    <TextBlock Text="🗑" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 下载进度条 -->
                    <Border Grid.Row="0" Background="{DynamicResource BgToolbar}" CornerRadius="6" Padding="16" Margin="12,12,12,0"
                            IsVisible="{Binding IsDownloading}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DownloadStatus}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Grid.Column="1" Text="{Binding DownloadProgress, StringFormat='{}{0:F1}%'}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentColor}"/>
                            </Grid>
                            <ProgressBar Value="{Binding DownloadProgress}" Height="6" CornerRadius="3"/>
                            <Button Content="取消下载" Command="{Binding CancelDownloadCommand}" HorizontalAlignment="Right" Padding="12,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Tab 内容区 -->
                    <TabControl Grid.Row="1" Margin="12,12,12,12" Classes="BottomTabs">
                        <TabItem Header="软件信息">
                            <ScrollViewer Margin="8">
                                <StackPanel Spacing="16">
                                    <!-- 描述 -->
                                    <Border Background="{DynamicResource BgToolbar}" CornerRadius="8" Padding="16">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="软件描述" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding SelectedSoftware.Description, TargetNullValue='暂无描述'}"
                                                       FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                                                       Opacity="0.8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 详细信息 -->
                                    <Border Background="{DynamicResource BgToolbar}" CornerRadius="8" Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="详细信息" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                                <TextBlock Grid.Column="0" Grid.Row="0" Text="下载次数:" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding SelectedSoftware.DownloadCount}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>

                                                <TextBlock Grid.Column="0" Grid.Row="1" Text="许可证:" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding SelectedSoftware.License, TargetNullValue='未知'}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>

                                                <TextBlock Grid.Column="0" Grid.Row="2" Text="操作系统:" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding SelectedSoftware.OperatingSystem, TargetNullValue='Windows'}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>

                                                <TextBlock Grid.Column="0" Grid.Row="3" Text="架构:" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding SelectedSoftware.Architecture, TargetNullValue='x64'}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>

                                                <TextBlock Grid.Column="0" Grid.Row="4" Text="最后更新:" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding SelectedSoftware.LastUpdated, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 标签 -->
                                    <Border Background="{DynamicResource BgToolbar}" CornerRadius="8" Padding="16"
                                            IsVisible="{Binding SelectedSoftware.Tags.Count, Converter={x:Static vm:IntToBoolConverterForVisibility.Instance}}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="标签" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                            <ItemsControl ItemsSource="{Binding SelectedSoftware.Tags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource AccentColor}" Opacity="0.2" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextPrimary}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="下载地址">
                            <ScrollViewer Margin="8">
                                <StackPanel Spacing="16">
                                    <!-- 下载地址 -->
                                    <Border Background="{DynamicResource BgToolbar}" CornerRadius="8" Padding="16">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="下载地址" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBox Grid.Column="0" Text="{Binding SelectedSoftware.DownloadUrl}" IsReadOnly="True"
                                                         FontSize="12" Watermark="暂无下载地址"/>
                                                <Button Grid.Column="1" Content="复制" Padding="12,6" Margin="8,0,0,0"
                                                        Command="{Binding CopyDownloadUrlCommand}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 本地文件 -->
                                    <Border Background="{DynamicResource BgToolbar}" CornerRadius="8" Padding="16"
                                            IsVisible="{Binding SelectedSoftware.LocalPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="本地文件" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBox Grid.Column="0" Text="{Binding SelectedSoftware.LocalPath}" IsReadOnly="True" FontSize="12"/>
                                                <Button Grid.Column="1" Content="打开" Padding="12,6" Margin="8,0,0,0"
                                                        Command="{Binding OpenFileLocationCommand}"/>
                                                <Button Grid.Column="2" Content="运行" Padding="12,6" Margin="8,0,0,0"
                                                        Command="{Binding RunSoftwareCommand}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="官网信息">
                            <ScrollViewer Margin="8">
                                <Border Background="{DynamicResource BgToolbar}" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="官网信息" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="官网地址:" FontSize="12" Opacity="0.6" Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedSoftware.Website, TargetNullValue='暂无'}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Button Content="访问官网" HorizontalAlignment="Left" Padding="12,6"
                                                Command="{Binding OpenWebsiteCommand}"
                                                IsVisible="{Binding SelectedSoftware.Website, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- 编辑对话框 -->
        <Border Grid.RowSpan="2" Background="#80000000" CornerRadius="6"
                IsVisible="{Binding IsEditing}">
            <Border Background="{DynamicResource BgContent}" CornerRadius="8" Padding="24" MinWidth="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="编辑软件" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimary}"/>

                    <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="名称:" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding EditingSoftware.Name}" Margin="0,4"/>

                        <TextBlock Grid.Column="0" Grid.Row="1" Text="版本:" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding EditingSoftware.Version}" Margin="0,4"/>

                        <TextBlock Grid.Column="0" Grid.Row="2" Text="分类:" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <ComboBox Grid.Column="1" Grid.Row="2" ItemsSource="{x:Static models:SoftwareCategories.All}"
                                  SelectedItem="{Binding EditingSoftware.Category}" Margin="0,4"/>

                        <TextBlock Grid.Column="0" Grid.Row="3" Text="大小:" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding EditingSoftware.Size}" Margin="0,4" Watermark="如: ~50MB"/>

                        <TextBlock Grid.Column="0" Grid.Row="4" Text="下载地址:" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding EditingSoftware.DownloadUrl}" Margin="0,4"/>

                        <TextBlock Grid.Column="0" Grid.Row="5" Text="官网:" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Grid.Column="1" Grid.Row="5" Text="{Binding EditingSoftware.Website}" Margin="0,4"/>

                        <TextBlock Grid.Column="0" Grid.Row="6" Text="发布者:" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBox Grid.Column="1" Grid.Row="6" Text="{Binding EditingSoftware.Publisher}" Margin="0,4"/>

                        <TextBlock Grid.Column="0" Grid.Row="7" Text="描述:" VerticalAlignment="Top" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,0"/>
                        <TextBox Grid.Column="1" Grid.Row="7" Text="{Binding EditingSoftware.Description}" Margin="0,4" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="取消" Command="{Binding CancelEditCommand}" Padding="16,8"/>
                        <Button Content="保存" Command="{Binding SaveEditCommand}" Padding="16,8" Background="{DynamicResource AccentColor}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
